{
  "manifest_version": 3,
  "name": "Яндекс Музыка — только музыка",
  "version": "1.0.1",
  "description": "Убирает лишние разделы Яндекс Музыки. Неофициальное расширение, не связано с Яндексом.",
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.uz/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
